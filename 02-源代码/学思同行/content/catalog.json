    "questions": [
      {
        "id": "data-structures-q1",
        "stem": "在顺序表中按下标访问一个元素的时间复杂度通常是？",
        "options": [
          {
            "key": "A",
            "text": "O(1)"
          },
          {
            "key": "B",
            "text": "O(log n)"
          },
          {
            "key": "C",
            "text": "O(n)"
          },
          {
            "key": "D",
            "text": "O(n²)"
          }
        ],
        "answer": "A",
        "explanation": "连续存储允许直接计算地址，因此按下标访问为 O(1)。这不代表插入也是 O(1)。",
        "concept": "线性表",
        "difficulty": "基础"
      },
      {
        "id": "data-structures-q2",
        "stem": "数组长度为8的循环队列预留一个空位，有效容量是多少？",
        "options": [
          {
            "key": "A",
            "text": "8"
          },
          {
            "key": "B",
            "text": "7"
          },
          {
            "key": "C",
            "text": "9"
          },
          {
            "key": "D",
            "text": "4"
          }
        ],
        "answer": "B",
        "explanation": "预留一槽用于区分空满，有效容量是 m-1=7。",
        "concept": "栈与队列",
        "difficulty": "基础"
      },
      {
        "id": "data-structures-q3",
        "stem": "用邻接表遍历具有 V 个顶点、E 条边的图，复杂度为？",
        "options": [
          {
            "key": "A",
            "text": "O(V²)"
          },
          {
            "key": "B",
            "text": "O(E²)"
          },
          {
            "key": "C",
            "text": "O(V+E)"
          },
          {
            "key": "D",
            "text": "O(log V)"
          }
        ],
        "answer": "C",
        "explanation": "每个顶点和每条邻接边常数次访问，合计 Θ(V+E)。",
        "concept": "图的存储与遍历",
        "difficulty": "基础"
      },
      {
        "id": "data-structures-q4",
        "stem": "Dijkstra 算法通常要求边权满足什么条件？",
        "options": [
          {
            "key": "A",
            "text": "所有边权相等"
          },
          {
            "key": "B",
            "text": "允许任意负边"
          },
          {
            "key": "C",
            "text": "必须是整数"
          },
          {
            "key": "D",
            "text": "非负"
          }
        ],
        "answer": "D",
        "explanation": "贪心确定最短距离依赖非负边权；负边可能让已确定距离继续降低。",
        "concept": "最短路径",
        "difficulty": "基础"
      },
      {
        "id": "data-structures-q5",
        "stem": "自底向上建立二叉堆的时间复杂度是？",
        "options": [
          {
            "key": "A",
            "text": "O(n)"
          },
          {
            "key": "B",
            "text": "O(n log n)"
          },
          {
            "key": "C",
            "text": "O(n²)"
          },
          {
            "key": "D",
            "text": "O(log n)"
          }
        ],
        "answer": "A",
        "explanation": "按节点高度加权求和得到 O(n)，多数节点下沉很少。",
        "concept": "堆与优先队列",
        "difficulty": "进阶"
      },
      {
        "id": "data-structures-q6",
        "stem": "哪种常见排序通常不稳定？",
        "options": [
          {
            "key": "A",
            "text": "归并排序"
          },
          {
            "key": "B",
            "text": "堆排序"
          },
          {
            "key": "C",
            "text": "插入排序"
          },
          {
            "key": "D",
            "text": "冒泡排序"
          }
        ],
        "answer": "B",
        "explanation": "堆中的远距离交换可能改变等键记录的相对顺序。",
        "concept": "排序与稳定性",
        "difficulty": "进阶"
      },
      {
        "id": "data-structures-q7",
        "stem": "非空二叉树有7个度为2的节点，叶子节点数是？",
        "options": [
          {
            "key": "A",
            "text": "7"
          },
          {
            "key": "B",
            "text": "6"
          },
          {
            "key": "C",
            "text": "8"
          },
          {
            "key": "D",
            "text": "14"
          }
        ],
        "answer": "C",
        "explanation": "n₀=n₂+1=8，来自树的节点数与边数关系。",
        "concept": "二叉树与遍历",
        "difficulty": "进阶"
      },
      {
        "id": "data-structures-q8",
        "stem": "以下哪种遍历能得到二叉搜索树键值的有序序列？",
        "options": [
          {
            "key": "A",
            "text": "层序"
          },
          {
            "key": "B",
            "text": "后序"
          },
          {
            "key": "C",
            "text": "前序"
          },
          {
            "key": "D",
            "text": "中序"
          }
        ],
        "answer": "D",
        "explanation": "中序先访问较小的左子树，再根，再较大的右子树。",
        "concept": "二叉搜索树与AVL",
        "difficulty": "进阶"
      },
      {
        "id": "data-structures-q9",
        "stem": "BFS 能直接保证最少边数路径的适用图是？",
        "options": [
          {
            "key": "A",
            "text": "无权图"
          },
          {
            "key": "B",
            "text": "任意负权图"
          },
          {
            "key": "C",
            "text": "任意加权图"
          },
          {
            "key": "D",
            "text": "只限树"
          }
        ],
        "answer": "A",
        "explanation": "BFS按距离层扩展，在无权图中距离是边数。",
        "concept": "图的存储与遍历",
        "difficulty": "挑战"
      },
      {
        "id": "data-structures-q10",
        "stem": "有向图拓扑排序未能输出所有顶点，通常说明？",
        "options": [
          {
            "key": "A",
            "text": "顶点没有编号"
          },
          {
            "key": "B",
            "text": "存在有向环"
          },
          {
            "key": "C",
            "text": "所有边权为负"
          },
          {
            "key": "D",
            "text": "图是完全图"
          }
        ],
        "answer": "B",
        "explanation": "环上节点彼此等待前驱入度清零，因此无法全部输出。",
        "concept": "最小生成树与拓扑排序",
        "difficulty": "挑战"
      },
      {
        "id": "data-structures-q11",
        "stem": "长度 n 的有序数组进行二分查找，最坏时间为？",
        "options": [
          {
            "key": "A",
            "text": "O(n)"
          },
          {
            "key": "B",
            "text": "O(n²)"
          },
          {
            "key": "C",
            "text": "O(log n)"
          },
          {
            "key": "D",
            "text": "O(1)"
          }
        ],
        "answer": "C",
        "explanation": "每次将候选范围约减半，至多对数次比较。",
        "concept": "查找与散列",
        "difficulty": "挑战"
      },
      {
        "id": "data-structures-q12",
        "stem": "递归 T(n)=2T(n/2)+Θ(n) 的紧确界为？",
        "options": [
          {
            "key": "A",
            "text": "Θ(n²)"
          },
          {
            "key": "B",
            "text": "Θ(log n)"
          },
          {
            "key": "C",
            "text": "Θ(n)"
          },
          {
            "key": "D",
            "text": "Θ(n log n)"
          }
        ],
        "answer": "D",
        "explanation": "每层工作量 Θ(n)，共有 Θ(log n) 层。",
        "concept": "复杂度分析",
        "difficulty": "挑战"
      }
    ]
  },
