            "text": "最长前缀匹配"
          },
          {
            "key": "B",
            "text": "最短前缀匹配"
          },
          {
            "key": "C",
            "text": "最大IP数字"
          },
          {
            "key": "D",
            "text": "随机匹配"
          }
        ],
        "answer": "A",
        "explanation": "最长匹配前缀代表最具体的目的范围。",
        "concept": "ARP与转发",
        "difficulty": "进阶"
      },
