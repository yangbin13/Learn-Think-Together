    "questions": [
      {
        "id": "operating-systems-q1",
        "stem": "正在运行的进程等待I/O完成时转为什么状态？",
        "options": [
          {
            "key": "A",
            "text": "阻塞"
          },
          {
            "key": "B",
            "text": "就绪"
          },
          {
            "key": "C",
            "text": "运行"
          },
          {
            "key": "D",
            "text": "终止"
          }
        ],
        "answer": "A",
        "explanation": "等待外部事件时无法继续运行，进入阻塞，完成后通常进入就绪。",
        "concept": "进程与线程",
        "difficulty": "基础"
      },
      {
        "id": "operating-systems-q2",
        "stem": "4KiB页面在字节地址中需要多少位页内偏移？",
        "options": [
          {
            "key": "A",
            "text": "10"
          },
          {
            "key": "B",
            "text": "12"
          },
          {
            "key": "C",
            "text": "20"
          },
          {
            "key": "D",
            "text": "32"
          }
        ],
        "answer": "B",
        "explanation": "4KiB=4096=2¹²字节，偏移占12位。",
        "concept": "分页与地址转换",
        "difficulty": "基础"
      },
      {
        "id": "operating-systems-q3",
        "stem": "哪一种页面置换算法可能出现Belady异常？",
        "options": [
          {
            "key": "A",
            "text": "LRU"
          },
          {
            "key": "B",
            "text": "OPT"
          },
          {
            "key": "C",
            "text": "FIFO"
          },
          {
            "key": "D",
            "text": "上述都不会"
          }
        ],
        "answer": "C",
        "explanation": "FIFO不是栈算法，增加页框可能增加缺页次数。",
        "concept": "页面置换",
        "difficulty": "基础"
      },
      {
        "id": "operating-systems-q4",
        "stem": "银行家算法判定不安全状态，可以推断？",
        "options": [
          {
            "key": "A",
            "text": "已经发生死锁"
          },
          {
            "key": "B",
            "text": "所有进程立即终止"
          },
          {
            "key": "C",
            "text": "没有资源分配"
          },
          {
            "key": "D",
            "text": "不能保证存在完成所有进程的安全序列"
          }
        ],
        "answer": "D",
        "explanation": "不安全不等于已死锁，而是无法证明存在安全序列。",
        "concept": "死锁",
        "difficulty": "基础"
      },
      {
        "id": "operating-systems-q5",
        "stem": "容量N的生产者消费者缓冲区，empty初值是？",
        "options": [
          {
            "key": "A",
            "text": "N"
          },
          {
            "key": "B",
            "text": "0"
          },
          {
            "key": "C",
            "text": "1"
          },
          {
            "key": "D",
            "text": "N-1"
          }
        ],
        "answer": "A",
        "explanation": "empty记录空槽，初始缓冲区为空，共N个空槽。",
        "concept": "信号量与生产消费",
        "difficulty": "进阶"
      },
      {
        "id": "operating-systems-q6",
        "stem": "TLB10ns、内存100ns、命中率90%，失配读页表再读数据、无缺页，EAT为？",
        "options": [
          {
            "key": "A",
            "text": "110ns"
          },
          {
            "key": "B",
            "text": "120ns"
          },
          {
            "key": "C",
            "text": "200ns"
          },
          {
            "key": "D",
            "text": "210ns"
          }
        ],
        "answer": "B",
        "explanation": "0.9×(10+100)+0.1×(10+100+100)=120ns。",
        "concept": "TLB与缺页",
        "difficulty": "进阶"
      },
      {
        "id": "operating-systems-q7",
        "stem": "进程到达时刻2、完成时刻11，其周转时间为？",
        "options": [
          {
            "key": "A",
            "text": "11"
          },
          {
            "key": "B",
            "text": "13"
          },
          {
            "key": "C",
            "text": "9"
          },
          {
            "key": "D",
            "text": "2"
          }
        ],
        "answer": "C",
        "explanation": "周转=完成-到达=11-2=9，尚不能仅凭此确定等待时间。",
        "concept": "调度算法",
        "difficulty": "进阶"
      },
      {
        "id": "operating-systems-q8",
        "stem": "分页内存管理通常可能产生哪种碎片？",
        "options": [
          {
            "key": "A",
            "text": "只产生外部碎片"
          },
          {
            "key": "B",
            "text": "完全没有碎片"
          },
          {
            "key": "C",
            "text": "磁盘碎片"
          },
          {
            "key": "D",
            "text": "内部碎片"
          }
        ],
        "answer": "D",
        "explanation": "末页未使用空间形成页内内部碎片，物理页无需连续。",
        "concept": "分页与地址转换",
        "difficulty": "进阶"
      },
      {
        "id": "operating-systems-q9",
        "stem": "同一进程的多个线程一般共享什么？",
        "options": [
          {
            "key": "A",
            "text": "地址空间"
          },
          {
            "key": "B",
            "text": "每个线程独立栈"
          },
          {
            "key": "C",
            "text": "全部寄存器状态"
          },
          {
            "key": "D",
            "text": "程序计数器"
          }
        ],
        "answer": "A",
        "explanation": "同一进程线程共享地址空间，各自有执行寄存器和栈。",
        "concept": "进程与线程",
        "difficulty": "挑战"
      },
      {
        "id": "operating-systems-q10",
        "stem": "LRU，3个页框，引用1,2,3,1,4，装入4时淘汰谁？",
        "options": [
          {
            "key": "A",
            "text": "1"
          },
          {
            "key": "B",
            "text": "2"
          },
          {
            "key": "C",
            "text": "3"
          },
          {
            "key": "D",
            "text": "4"
          }
        ],
        "answer": "B",
        "explanation": "最后访问1更新其最近性，2是最长时间未访问的页。",
        "concept": "页面置换",
        "difficulty": "挑战"
      },
      {
        "id": "operating-systems-q11",
        "stem": "频繁调页导致CPU利用率下降通常称为？",
        "options": [
          {
            "key": "A",
            "text": "缓存命中"
          },
          {
            "key": "B",
            "text": "中断屏蔽"
          },
          {
            "key": "C",
            "text": "抖动"
          },
          {
            "key": "D",
            "text": "安全状态"
          }
        ],
        "answer": "C",
        "explanation": "活跃工作集无法容纳时，进程大量时间耗在分页I/O。",
        "concept": "工作集与抖动",
        "difficulty": "挑战"
      },
      {
        "id": "operating-systems-q12",
        "stem": "以下哪项不是死锁四个必要条件之一？",
        "options": [
          {
            "key": "A",
            "text": "互斥"
          },
          {
            "key": "B",
            "text": "占有并等待"
          },
          {
            "key": "C",
            "text": "循环等待"
          },
          {
            "key": "D",
            "text": "资源可无限复制"
          }
        ],
        "answer": "D",
        "explanation": "必要条件为互斥、占有并等待、不可剥夺、循环等待。",
        "concept": "死锁",
        "difficulty": "挑战"
      }
    ]
