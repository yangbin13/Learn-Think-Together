            "key": "A",
            "text": "拥塞控制"
          },
          {
            "key": "B",
            "text": "流量控制"
          },
          {
            "key": "C",
            "text": "DNS解析"
          },
          {
            "key": "D",
            "text": "路由学习"
          }
        ],
        "answer": "B",
        "explanation": "rwnd反映接收端可用缓冲区，保护接收方。",
        "concept": "流量与拥塞控制",
        "difficulty": "进阶"
      },
