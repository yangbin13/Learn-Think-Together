    "questions": [
      {
        "id": "computer-organization-q1",
        "stem": "10⁶条指令、CPI=2、时钟频率1GHz，CPU时间是多少？",
        "options": [
          {
            "key": "A",
            "text": "2ms"
          },
          {
            "key": "B",
            "text": "2s"
          },
          {
            "key": "C",
            "text": "0.5ms"
          },
          {
            "key": "D",
            "text": "1μs"
          }
        ],
        "answer": "A",
        "explanation": "10⁶×2/10⁹ 秒=0.002秒=2ms。",
        "concept": "性能与CPU时间",
        "difficulty": "基础"
      },
      {
        "id": "computer-organization-q2",
        "stem": "8位补码可表示的范围是？",
        "options": [
          {
            "key": "A",
            "text": "-127到127"
          },
          {
            "key": "B",
            "text": "-128到127"
          },
          {
            "key": "C",
            "text": "0到255"
          },
          {
            "key": "D",
            "text": "-128到128"
          }
        ],
        "answer": "B",
        "explanation": "范围 [-2⁷,2⁷-1]=[-128,127]。",
        "concept": "补码与整数运算",
        "difficulty": "基础"
      },
      {
        "id": "computer-organization-q3",
        "stem": "理想5级流水线运行10条指令需要几个周期？",
        "options": [
          {
            "key": "A",
            "text": "50"
          },
          {
            "key": "B",
            "text": "10"
          },
          {
            "key": "C",
            "text": "14"
          },
          {
            "key": "D",
            "text": "15"
          }
        ],
        "answer": "C",
        "explanation": "k+n-1=5+10-1=14，假设等时且无停顿。",
        "concept": "流水线",
        "difficulty": "基础"
      },
      {
        "id": "computer-organization-q4",
        "stem": "命中时间2ns，缺失率5%，缺失额外代价80ns，AMAT为？",
        "options": [
          {
            "key": "A",
            "text": "82ns"
          },
          {
            "key": "B",
            "text": "4ns"
          },
          {
            "key": "C",
            "text": "80ns"
          },
          {
            "key": "D",
            "text": "6ns"
          }
        ],
        "answer": "D",
        "explanation": "AMAT=2+0.05×80=6ns，80ns为额外代价。",
        "concept": "Cache性能",
        "difficulty": "基础"
      },
      {
        "id": "computer-organization-q5",
        "stem": "字节寻址、Cache块大小64B，块内偏移位数为？",
        "options": [
          {
            "key": "A",
            "text": "6"
          },
          {
            "key": "B",
            "text": "8"
          },
          {
            "key": "C",
            "text": "4"
          },
          {
            "key": "D",
            "text": "64"
          }
        ],
        "answer": "A",
        "explanation": "64=2⁶，偏移需要6位。",
        "concept": "Cache与局部性",
        "difficulty": "进阶"
      },
      {
        "id": "computer-organization-q6",
        "stem": "CPU大量重复访问刚使用的数据体现？",
        "options": [
          {
            "key": "A",
            "text": "空间局部性"
          },
          {
            "key": "B",
            "text": "时间局部性"
          },
          {
            "key": "C",
            "text": "均匀随机访问"
          },
          {
            "key": "D",
            "text": "全局共享"
          }
        ],
        "answer": "B",
        "explanation": "近期访问数据再次使用是时间局部性。",
        "concept": "Cache与局部性",
        "difficulty": "进阶"
      },
      {
        "id": "computer-organization-q7",
        "stem": "某部分占程序原执行时间的80%，仅将这部分加速4倍，其余部分执行时间不变，整体加速比为？",
        "options": [
          {
            "key": "A",
            "text": "4"
          },
          {
            "key": "B",
            "text": "3.2"
          },
          {
            "key": "C",
            "text": "2.5"
          },
          {
            "key": "D",
            "text": "5"
          }
        ],
        "answer": "C",
        "explanation": "1/(0.2+0.8/4)=2.5。",
        "concept": "Amdahl定律",
        "difficulty": "进阶"
      },
      {
        "id": "computer-organization-q8",
        "stem": "TLB未命中意味着什么？",
        "options": [
          {
            "key": "A",
            "text": "一定发生缺页"
          },
          {
            "key": "B",
            "text": "必须读磁盘"
          },
          {
            "key": "C",
            "text": "进程必然结束"
          },
          {
            "key": "D",
            "text": "需要进一步查页表，不一定缺页"
          }
        ],
        "answer": "D",
        "explanation": "页表项可能表明页面已在主存，失配仅增加地址转换访问。",
        "concept": "主存与虚拟存储",
        "difficulty": "进阶"
      },
      {
        "id": "computer-organization-q9",
        "stem": "通常需要周期刷新的是？",
        "options": [
          {
            "key": "A",
            "text": "DRAM"
          },
          {
            "key": "B",
            "text": "SRAM"
          },
          {
            "key": "C",
            "text": "寄存器"
          },
          {
            "key": "D",
            "text": "ROM"
          }
        ],
        "answer": "A",
        "explanation": "DRAM用电容存储电荷，会泄漏，需要刷新。",
        "concept": "主存与虚拟存储",
        "difficulty": "挑战"
      },
      {
        "id": "computer-organization-q10",
        "stem": "IEEE754单精度正规数的阶码偏置为？",
        "options": [
          {
            "key": "A",
            "text": "128"
          },
          {
            "key": "B",
            "text": "127"
          },
          {
            "key": "C",
            "text": "1023"
          },
          {
            "key": "D",
            "text": "15"
          }
        ],
        "answer": "B",
        "explanation": "8位阶码的偏置为127，特殊阶码要另行解释。",
        "concept": "浮点数",
        "difficulty": "挑战"
      },
      {
        "id": "computer-organization-q11",
        "stem": "DMA传输期间CPU的合理角色是？",
        "options": [
          {
            "key": "A",
            "text": "逐字节搬运全部数据"
          },
          {
            "key": "B",
            "text": "从不参与"
          },
          {
            "key": "C",
            "text": "设置传输并处理完成事件"
          },
          {
            "key": "D",
            "text": "关闭所有中断"
          }
        ],
        "answer": "C",
        "explanation": "DMA控制器搬运数据，CPU仍负责配置和完成处理。",
        "concept": "总线与I/O",
        "difficulty": "挑战"
      },
      {
        "id": "computer-organization-q12",
        "stem": "补码同号整数相加而结果异号，通常说明？",
        "options": [
          {
            "key": "A",
            "text": "没有进位"
          },
          {
            "key": "B",
            "text": "结果总是正确"
          },
          {
            "key": "C",
            "text": "只发生无符号溢出"
          },
          {
            "key": "D",
            "text": "带符号溢出"
          }
        ],
        "answer": "D",
        "explanation": "同号加法不可能在可表示范围内得到异号，因此发生带符号溢出。",
        "concept": "补码与整数运算",
        "difficulty": "挑战"
      }
    ]
  },
