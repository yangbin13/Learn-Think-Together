# 首次使用：将本文件复制为源码项目根目录的 .env，后端从该文件读取配置。
# 最小在线配置：使用下方普通 MiMo 地址与模型时，只需在本机填写 LLM_API_KEY。
# 若使用不同平台、模型或 Token Plan，再按服务商提供的信息核对 LLM_API_BASE / LLM_MODEL。
# 其他选项可保持默认；单一 MiMo 凭证可用于教学、工具规划、教材出题与审核。
# 未填写有效模型凭证时，可体验教材、原创题库、导图和计划，但不能得到在线模型答复。
# 修改 .env 后重启后端。实际凭证不要写入交付文档、视频或公开源码。
LLM_API_BASE=https://api.xiaomimimo.com/v1
LLM_API_KEY=
LLM_MODEL=mimo-v2.6-flash
# 教学、工具规划、自建教材出题、审核和PDF页图默认共用 LLM_MODEL。
# Token Plan 用户请将 LLM_API_BASE 换成自己套餐提供的地址。
# 以下覆盖项仅在需要不同生成模型时填写；内置408题库不调用出题模型。
LLM_QUIZ_MODEL=
# MiMo 使用 thinking.type；硅基流动兼容接口使用 enable_thinking。
LLM_QUIZ_THINKING=false
# 仅出题推理开启时上游采用；128..32768，默认1024。是token预算，不是费用上限。
LLM_QUIZ_THINKING_BUDGET=1024
# 可选：用另一模型复核答案/练习，留空复用 LLM_MODEL。
LLM_REVIEW_MODEL=
# MiMo 使用 thinking.type；硅基流动兼容接口使用 enable_thinking。
LLM_REVIEW_THINKING=false
# 仅上述推理审核开启时传递；128..32768，与正文/总输出上限不同。
LLM_REVIEW_THINKING_BUDGET=1024
# 0 使用任务默认预算；最多32768。
LLM_MIN_OUTPUT_TOKENS=0
# JSON模式用于出题/审核/单步提示；服务不支持 response_format 时可关闭。
# 返回格式始终严格校验；接口不支持JSON模式时，有界尝试函数封装与纯JSON回退，真实用量累计。
LLM_JSON_MODE_ENABLED=true
# 单一 MiMo Key 即可运行教材检索（BM25）；MiMo 不提供本项目所用的 embeddings 接口。
# 如需 BGE-M3 语义向量，设 EMBEDDING_ENABLED=true 并填写独立向量服务的 URL/Key。
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_ENABLED=false
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
# 留空沿用 LLM_MODEL；也可显式指定另一视觉模型。
VISION_MODEL=
VISION_ENABLED=true
TUTOR_DATA_DIR=data
# 单份教材上传上限，单位 MiB；整数 1..512，默认 200，修改后重启。
MAX_UPLOAD_MB=200
# 正式 HTTPS 部署设置 true；本机 HTTP 保持 false。
COOKIE_SECURE=false
PROVIDER_TIMEOUT_SECONDS=90

